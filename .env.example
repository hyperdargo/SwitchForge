PORT=6010
APP_ORIGIN=http://localhost:6009
PUBLIC_API_URL=http://localhost:6010/v1
GMAIL_USER=your-account@gmail.com
GMAIL_APP_PASSWORD=your-google-app-password
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=your-omniroute-api-key
SESSION_SECRET=replace-with-a-long-random-secret

# Use "r2" for durable Cloudflare object storage or "local" for server/data/db.json.
STORAGE_BACKEND=r2
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=switchforge
R2_OBJECT_KEY=data/db.json
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
